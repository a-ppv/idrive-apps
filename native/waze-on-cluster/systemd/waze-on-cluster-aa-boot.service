[Unit]
Description=waze-on-cluster boot check: arm the Android Auto patch in memory for aapd's start, or leave aapd stock if the patch keeps the head unit from starting
RequiresMountsFor=/var/opt
# codingshm publishes the cluster coding a plan still to make reads; aapd is
# ordered after it too, so this adds no wait to aapd's start.
After=local-fs.target codingshm.service
# aapd.service (WantedBy=late.target, after multi-user.target) starts only
# once this has finished, failed or timed out; it does not require it.
Before=aapd.service

[Service]
# As waze-on-cluster-boot.service does for carplay (PATCH.md "Boot
# recovery"): it records a boot that starts aapd armed and arms that start,
# or at the threshold leaves it stock. A patch an earlier release wrote to
# aapd or aapd.conf is put back before aapd starts: / is remounted
# read-write only to write the verified originals, then read-only again.
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/node /var/opt/waze-on-cluster/current/recovery.js boot aapd
# The step exits by 56 s whatever hangs (recovery.js BOOT_EXIT_MS), inside
# the start timeout. A stop mid-restore lets it finish, inside the stop
# timeout, so / is not left writable; KillMode=mixed signals only the step,
# not its mount children.
TimeoutStartSec=75
TimeoutStopSec=75
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
